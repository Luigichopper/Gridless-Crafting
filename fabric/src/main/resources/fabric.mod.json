{
  "schemaVersion": 1,
  "id": "gridless",
  "version": "${version}",
  "name": "Gridless Crafting",
  "description": "Terraria-style gridless crafting and station overhaul for Minecraft.",
  "authors": [
    "Luigi"
  ],
  "license": "MIT",
  "environment": "*",
  "entrypoints": {
    "main": [
      "com.gridless.fabric.GridlessCraftingFabric"
    ],
    "client": [
      "com.gridless.fabric.client.GridlessCraftingClientFabric"
    ],
    "modmenu": [
      "com.gridless.fabric.client.GridlessModMenuIntegration"
    ]
  },
  "mixins": [
    "gridless-common.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": ">=1.21.1",
    "fabric-api": "*"
  }
}
